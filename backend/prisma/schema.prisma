// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String?
  role          String    @default("STUDENT")
  avatar        String?
  bio           String?
  headline      String?
  location      String?
  linkedinUrl   String?
  githubUrl     String?
  websiteUrl    String?
  username      String?   @unique
  isVerified    Boolean   @default(false)
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userSkills         UserSkill[]
  testAttempts       TestAttempt[]
  projects           Project[]
  reviewerProfile    ReviewerProfile?
  recruiterAccess    RecruiterAccess?
  institutionAdmin   Institution[]
  refreshTokens      RefreshToken[]
  assignedReviews    Review[]         @relation("ReviewerToReview")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String
  icon        String?
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills   UserSkill[]
  skillTests   SkillTest[]
  testAttempts TestAttempt[]
  projects     Project[]
}

model UserSkill {
  id               String    @id @default(uuid())
  userId           String
  skillId          String
  status           String    @default("CLAIMED")
  credibilityScore Float     @default(0)
  verifiedAt       DateTime?
  claimedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill              Skill               @relation(fields: [skillId], references: [id])
  verificationRecord VerificationRecord?

  @@unique([userId, skillId])
}

model SkillTest {
  id              String   @id @default(uuid())
  skillId         String
  title           String
  description     String?
  questions       String   // JSON stored as text
  difficultyLevel String   @default("intermediate")
  timeLimit       Int      @default(30)
  passingScore    Float    @default(70)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skill        Skill         @relation(fields: [skillId], references: [id])
  testAttempts TestAttempt[]
}

model TestAttempt {
  id          String   @id @default(uuid())
  userId      String
  skillId     String
  testId      String
  score       Float
  answers     String   // JSON stored as text
  timeTaken   Int
  attemptDate DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill     @relation(fields: [skillId], references: [id])
  test  SkillTest @relation(fields: [testId], references: [id])
}

model Project {
  id              String   @id @default(uuid())
  userId          String
  skillId         String
  title           String
  description     String
  projectLink     String?
  repoLink        String?
  fileUrl         String?
  demoUrl         String?
  complexityScore Float?
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill    @relation(fields: [skillId], references: [id])
  reviews Review[]
}

model Review {
  id                  String    @id @default(uuid())
  projectId           String
  reviewerId          String
  qualityScore        Float?
  complexityScore     Float?
  originalityScore    Float?
  implementationScore Float?
  overallScore        Float?
  feedback            String?
  status              String    @default("PENDING")
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewerToReview", fields: [reviewerId], references: [id])

  @@unique([projectId, reviewerId])
}

model VerificationRecord {
  id             String   @id @default(uuid())
  userSkillId    String   @unique
  testScore      Float    @default(0)
  projectScore   Float    @default(0)
  reviewerScore  Float    @default(0)
  weightTest     Float    @default(0.35)
  weightProject  Float    @default(0.35)
  weightReviewer Float    @default(0.30)
  finalScore     Float    @default(0)
  verifiedFlag   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userSkill UserSkill @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
}

model ReviewerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  expertiseDomains String   @default("[]")
  credibilityRating Float   @default(5.0)
  totalReviews     Int      @default(0)
  approvedReviews  Int      @default(0)
  bio              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecruiterAccess {
  id               String    @id @default(uuid())
  recruiterId      String    @unique
  companyName      String?
  subscriptionPlan String    @default("FREE")
  accessLevel      Int       @default(1)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recruiter User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
}

model Institution {
  id            String   @id @default(uuid())
  name          String
  adminUserId   String
  domain        String?
  logoUrl       String?
  analyticsData String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin User @relation(fields: [adminUserId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
